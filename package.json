{
  "name": "rechtswinkel-amsterdam",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "source:fetch": "node scripts/source.mjs --fetch",
    "source:build": "node scripts/source.mjs",
    "cms:import": "node scripts/cms-import.mjs",
    "content:check": "node scripts/content-check.mjs",
    "release:check": "node scripts/content-check.mjs --production",
    "secrets:init": "node scripts/init-secrets.mjs",
    "test:cms": "node --test tests/cms.integration.mjs",
    "runtime:windows": "node scripts/local-runtime.mjs",
    "source:render": "node scripts/source-render.mjs",
    "cms:setup": "node scripts/docker-setup.mjs",
    "runtime:setup": "node scripts/setup-windows.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "entities": "8.1.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
